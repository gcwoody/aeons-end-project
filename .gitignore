# Dependencies
**/node_modules/

# Build output and TypeScript caches
**/dist/
**/.stage7-dist/
**/.vite/
**/*.tsbuildinfo

# Environment files and local secrets
.env
.env.*
!.env.example

# Local game saves
/aeons-end-engine/save.json

# Logs and debug output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Test coverage
**/coverage/

# Editor and OS files
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini

# Temporary Office files
~$*.pptx
~$*.docx
~$*.xlsx

# pictures
*.png
*.jpg

# Production image assets required by the Vite build.
# Keep the local image-database default ignored, but publish the assets that
# generate-image-imports.mjs imports into the friend preview bundle.
!image-database/cards/
!image-database/cards/wave1/
!image-database/cards/wave1/**/*.png
!image-database/cards/wave1/**/*.jpg
!image-database/cards/wave9/
!image-database/cards/wave9/**/*.png
!image-database/cards/wave9/**/*.jpg
!image-database/common breach/
!image-database/common breach/**/*.png
!image-database/common breach/**/*.jpg

# Resumable Wiki responses are generated locally by the collection scripts.
/image-database/.cache/
