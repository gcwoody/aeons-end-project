{
  "name": "aeons-end-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop shell for Aeon's End Digital",
  "main": "main.cjs",
  "scripts": {
    "dev": "node dev.mjs",
    "start": "electron .",
    "prepare:game": "npm --prefix ../aeons-end-ui run build:local-demo",
    "package:win": "node build-win.mjs",
    "package:share": "npm run prepare:game && npm run package:win && node package-share.mjs"
  },
  "build": {
    "appId": "com.aeonsendigital.desktop",
    "productName": "Aeon's End Digital",
    "executableName": "AeonsEnd",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.cjs",
      "package.json",
      "assets/app-icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AeonsEnd.${ext}",
      "compression": "store",
      "icon": "assets/app-icon.ico",
      "signExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
